# Murago Coffee ERP — environment example. Copy to .env
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production: PostGIS (GeoDjango). Example:
# DATABASE_URL=postgis://murago:secret@db:5432/murago
# Local dev without PostGIS/GDAL: leave unset -> SQLite fallback (see README).
DATABASE_URL=
MURAGO_USE_GIS=auto
